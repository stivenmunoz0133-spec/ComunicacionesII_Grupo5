options:
  parameters:
    author: 'Grupo 5: Elkin Largo, Stiven Muñoz, Minuk Lee'
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: GRC para analizar ruido AWGN en modulaciones basadas en constelaciones
    copyright: ''
    description: 'Copia modificada de Modulaciones_basadas_en_constelaciones_AWGN.grc. BPSK, pulso rectangular, canal camino directo + eco (retardo D_eco, ganancia compleja alpha) + AWGN y receptor: filtro
      acoplado, diagrama de ojo, muestreo 1 de Sps, decision y BER.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: S3_Multitrayectoria_BPSK_Grupo5
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: S3 Multitrayectoria BPSK - Grupo 5 (Tx-canal eco-Rx)
    window_size: (1600,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
