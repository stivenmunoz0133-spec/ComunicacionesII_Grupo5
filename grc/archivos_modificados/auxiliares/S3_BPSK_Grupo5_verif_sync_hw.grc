options:
  parameters:
    author: 'Grupo 5: Elkin Largo, Stiven Muñoz, Minuk Lee'
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: GRC para analizar ruido AWGN en modulaciones basadas en constelaciones
    copyright: ''
    description: Copia para hardware del transmisor. radio_rate = bb_rate*125/16 = 2 MS/s. LO desplazado lo_off para alejar la senal del spur DC. El canal eco puede EMULARSE digitalmente (eco_alpha) para
      pruebas conducidas por cable; con eco_alpha=0 se transmite la senal limpia.
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: no_gui
    hier_block_src_path: '.:'
    id: S3_BPSK_Grupo5_verif_sync
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: run
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Verificacion en simulacion del RX de hardware (offset de frecuencia y reloj)
    window_size: (1600,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
